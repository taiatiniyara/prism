# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.tmp
*.swp
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# common build outputs
dist/

# editor settings
.vscode/
.idea/

# agent tooling (local, not part of the app)
.claude/
# Impeccable design skill: shared config (.impeccable/config.json, design.json) is committed;
# per-developer consent + hook cache stay local
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/
.serena/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/launch.json

graphify-out/

# AI eval (scripts/ai-eval.ts): bulky/derived outputs stay out; cases, metrics, results.jsonl are committed
eval/**/traces/
eval/**/report.html
eval/**/state.json
eval/**/trajectory/
